# Loaded on top of .env when NODE_ENV=test. Every required variable is defined here so the
# suite also runs on a fresh clone without a .env file. Dummy values only, never real secrets.
TZ=UTC
PORT=3334
HOST=localhost
LOG_LEVEL=info

APP_KEY=test-app-key-with-at-least-32-characters
API_KEY=test-api-key
SESSION_DRIVER=memory
LIMITER_STORE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
TRUSTED_APP_ORIGIN_URL=localhost:3000
TRUSTED_DASHBOARD_ORIGIN_URL=localhost:5173
DB_URL=postgres://postgres:postgres@localhost:5432/taxdom_test

BETTER_AUTH_SECRET=test-better-auth-secret-with-32-characters
BETTER_AUTH_URL=http://localhost:3334

GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
