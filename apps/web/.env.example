API_URL=""
API_KEY=""
# Visitor IP resolution for server-side API calls (see src/lib/api/client-ip.ts).
# Header set by the ingress: e.g. cf-connecting-ip behind Cloudflare, x-real-ip
# behind nginx/traefik. Leave empty to use the rightmost x-forwarded-for entry.
CLIENT_IP_HEADER=""
# Must match the API PROXY_SHARED_SECRET. Server-only, never NEXT_PUBLIC_.
PROXY_SHARED_SECRET=""
NEXT_PUBLIC_API_URL=$API_URL
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_PLAUSIBLE_ANALYTICS=
# This default sitekey and secret forces an interactive challenge that always pass.
# This config is only for testing purposes.
# Docs : https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY="3x00000000000000000000FF"
NEXT_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
