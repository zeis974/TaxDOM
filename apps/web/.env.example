API_URL=""
API_KEY=""
# Browser-facing API URL, read at build time. Kept separate from API_URL, which can
# point to the internal Docker address in production.
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_WEBSITE_URL=
# Umami tracking script URL (e.g. https://stats.example.com/script.js) and website ID, read at build time. Analytics is disabled when unset.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# This default sitekey and secret forces an interactive challenge that always pass.
# This config is only for testing purposes.
# Docs : https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY="3x00000000000000000000FF"
NEXT_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
