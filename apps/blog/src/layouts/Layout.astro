---
import Header from "@/components/Header.astro"
import Navbar from "@/components/Navbar"

const { title } = Astro.props
---

<html lang="fr" transition:name="root" transition:animate="fade" >
  <head>
	<!--
	  Baseline CSP for the statically-built blog. 'unsafe-inline' is needed by the
	  anti-FOUC script below, Astro's island hydration and Panda's injected styles.
	  frame-ancestors cannot be set from a meta tag — X-Frame-Options must come
	  from the reverse proxy. See docs/SECURITY-AUDIT.md.
	-->
	<meta
	  http-equiv="Content-Security-Policy"
	  content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
	/>
	<title>TaxDOM | Blog</title>
	<Header title={title} description="cc"/>
  <script is:inline>
    (function () {
      try {
        const theme = localStorage.getItem('theme') || 'light'
        document.documentElement.classList.add(theme)
      } catch (e) {
        document.documentElement.classList.add('light')
      }
    })()
  </script>
  </head>
  <body>
    <Navbar client:load />
    <section class="container">
      <slot />
    </section>
  </body>
</html>

<style>
  .container {
    max-width: 1300px;
      margin: 0 auto;
    padding: 0 token(spacing.s20);
  }
</style>

